{
  "name": "amis-dt",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive Mobility Intelligence System — Digital Twin",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "22.x",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
